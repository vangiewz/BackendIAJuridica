# Copiar a .env y completar con las credenciales reales.
# El .env NUNCA se versiona.

# Base de datos PostgreSQL gestionada en Neon.
# Formato: postgresql://USUARIO:CLAVE@HOST/BASE?sslmode=require&channel_binding=require
DATABASE_URL="postgresql://usuario:clave@host.neon.tech/neondb?sslmode=require&channel_binding=require"

# development | staging | production
ENVIRONMENT=development
