# Copiar como `.env` (que no se sube a git) y completar DATABASE_URL y JWT_SECRET.
# Nunca poner valores reales en este archivo.

ENVIRONMENT=development

# PostgreSQL con pgvector (hoy: la base Neon actual). Pedir la cadena real al equipo.
# Formato: postgresql+psycopg://USUARIO:CLAVE@HOST/BASE?sslmode=require
DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/juridica

# Obligatorio si ENVIRONMENT no es development. En development se genera uno aleatorio
# en cada arranque (las sesiones abiertas dejan de valer al reiniciar). Generar uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# JWT_ACCESS_MINUTOS=30
# JWT_REFRESH_DIAS=7

# ---# --- SWITCH DE BASE DE DATOS (NUBE VS LOCAL) ---
# Opcion 1: Base de datos en la Nube (Neon - Por defecto para el equipo)
# REQUIERE INTERNET.
DATABASE_URL="postgresql://neondb_owner:xxxxxxxxxxxxxxxx@ep-xxxx-xxxx-xxxx.us-east-2.aws.neon.tech/legal_db?sslmode=require"

# Opcion 2: Base de datos Local (Modo Bunker)
# NO REQUIERE INTERNET. 
# Para usar esta opcion, primero debes correr scripts/start_local_db.ps1
# DATABASE_URL="postgresql://postgres:postgres@host.docker.internal:5433/postgres"
# -----------------------------------------------

# --- IA local (Ollama). El pipeline recomendado es `simple`. ---
IA_PIPELINE=simple
IA_ENABLED=true

# A donde se le pide la inferencia. Es la UNICA variable que hay que cambiar para alternar
# entre el Ollama de esta maquina y el que sirve la PC con GPU del equipo:
#
#   OLLAMA_URL=http://127.0.0.1:11434      # mi propio Ollama
#   OLLAMA_URL=https://ia.midominio.com    # la PC con GPU del equipo, por el tunel
#
# Se acepta loopback sobre http, o un destino remoto sobre https CON las credenciales de
# abajo. Nunca un Ollama remoto sin autenticar: Ollama no tiene login propio, y lo que quede
# publicado sin token queda usable por cualquiera que lo encuentre.
OLLAMA_URL=http://127.0.0.1:11434

# Service token de Cloudflare Access, obligatorio solo cuando OLLAMA_URL es remoto. Se deja
# configurado de forma permanente: cuando OLLAMA_URL es loopback estas dos se ignoran, asi que
# alternar entre las dos IAs no obliga a borrarlas. Pedirselas a quien sirve la IA.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Segundos para establecer la conexion. 3 alcanza en loopback; con el tunel de por medio
# conviene 10, que tolera una red mala sin colgar la consulta.
OLLAMA_CONNECT_TIMEOUT=3

# Vigencia (segundos) del cache de los chequeos previos de modelo. Recorta una consulta de 5
# peticiones a 2, que con el tunel son 3 viajes de red menos. 0 desactiva el cache.
OLLAMA_PREFLIGHT_TTL=300
OLLAMA_MODEL=qwen3:8b
EMBEDDING_MODEL=qwen3-embedding:0.6b
# Cuanto se espera la respuesta del modelo. Si OLLAMA_URL apunta al tunel, bajarlo a 95: el
# plan gratis de Cloudflare corta a los 100 s, y cortar antes da un error limpio en vez de un 524.
OLLAMA_TIMEOUT=180
OLLAMA_TEMPERATURE=0
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1800
OLLAMA_KEEP_ALIVE=30m
EMBEDDING_KEEP_ALIVE=30m

# 0 = los embeddings de las consultas se calculan en CPU (valor medido y validado).
# En una GPU NVIDIA con VRAM de sobra se puede probar 1, pero no es necesario.
EMBEDDING_NUM_GPU=0

# --- Recuperacion (RAG) ---
RAG_TOP_K=3
RAG_CANDIDATE_K=20
RAG_PARALLEL_EMBEDDING=true

# Limites por tarea; los borradores conservan OLLAMA_NUM_PREDICT.
OLLAMA_RAG_NUM_PREDICT=1100
OLLAMA_SHORT_NUM_PREDICT=600
IA_EXPLANATION_CACHE_SIZE=128
IA_EXPLANATION_CACHE_TTL=1800

# --- CORS: origenes web autorizados, separados por coma. ---
# El comodin "*" no sirve: la API permite credenciales y el navegador lo rechaza.
CORS_ORIGINS=https://ia-juridica-weld.vercel.app,http://localhost:8081,http://localhost:19006,http://localhost:3000
# Patron extra para los previews de Vercel (subdominio distinto en cada push). Vacio lo apaga.
CORS_ORIGIN_REGEX=^https://ia-juridica[\w-]*\.vercel\.app$
